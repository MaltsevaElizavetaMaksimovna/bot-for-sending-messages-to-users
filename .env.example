# Bot
BOT_TOKEN=your_bot_token_here

# Database
DB_PATH=databases/SQLite.db

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log # <- если пустой, то логирование только в консоль

# OAuth (VK ID)
AUTH_ENABLED=false
FLASK_SECRET_KEY=your_flask_secret_key
VK_CLIENT_ID=your_vk_client_id
VK_CLIENT_SECRET=your_vk_client_secret
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback
ALLOWED_VK_IDS=vk_ids